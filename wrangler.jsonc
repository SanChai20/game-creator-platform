{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-creator-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,   // the platform answers only on hearthcade.com (and www, which redirects)
  // The platform's own address. Games live on GAME_HOST (hearthcade.app), a different site, so a game page can never set
  // or read the platform's cookies. www redirects pages to PUBLIC_ORIGIN (src/index.ts).
  "routes": [
    { "pattern": "hearthcade.com", "custom_domain": true },
    { "pattern": "www.hearthcade.com", "custom_domain": true },
    // The shared game host (DEPLOY_DRIVER "shared", src/game-host.ts): every game at <script>.hearthcade.app. A game that
    // still has a Worker of its own keeps its per-script route, which is more specific, until the rollout moves it.
    { "pattern": "*.hearthcade.app/*", "zone_id": "696f63e1c098bfd778b39bf941ae69c4" }
  ],
  // games' server code runs as Dynamic Workers loaded by the shared game host
  "worker_loaders": [{ "binding": "LOADER" }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Pages go through the Worker too, so the other hosts of this Worker (workers.dev, www) redirect them to
    // PUBLIC_ORIGIN; only fingerprinted build files, fonts and icons are served straight from the asset store.
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/icons/*", "!/favicon.svg"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "gcp-db", "database_id": "111e0b7d-ed5f-4e81-97bd-8ba0444e54bf", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "gcp-games" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "d573f7e6dbe34a35993fd1ac678687c0" }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "PIPELINE", "class_name": "Pipeline" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },   // server-run matches (src/matchmaker.ts)
      // the play clock at scale (setting play_clock_do, src/clock-do.ts): one per player, one per game
      { "name": "PLAY_CLOCK", "class_name": "PlayClock" },
      { "name": "GAME_TALLY", "class_name": "GameTally" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Pipeline"] }, { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] }, { "tag": "v3", "new_sqlite_classes": ["PlayClock", "GameTally"] }],
  // Game service calls (saves, stats, scores, heartbeats, server store) per play session and per game Worker, without a
  // database write per check (src/routes/rt.ts). Counted per Cloudflare location, so the limits are generous.
  "ratelimits": [
    { "name": "PLAY_RL", "namespace_id": "4201", "simple": { "limit": 240, "period": 60 } },
    { "name": "SERVER_RL", "namespace_id": "4202", "simple": { "limit": 3000, "period": 60 } }
  ],
  "browser": { "binding": "BROWSER" },
  "ai": { "binding": "AI" },
  // Cloudflare Email Service: payout emails to creators (src/mail.ts). Sends nothing until the domain is onboarded under
  // Compute > Email Service > Email Sending; sending to any address needs the Workers Paid plan.
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["17 3 * * *", "*/10 * * * *", "* * * * *"] },   // daily cleanup and payouts; every 10 min trending scores, today's picks and the runtime rollout; every minute playing now (src/rankings.ts lists them all)
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],
  "observability": { "enabled": true },
  // Workers for Platforms (docs/workers-for-platforms.md): with DEPLOY_DRIVER "dispatch", games are user Workers in this
  // namespace. The platform uses the binding for health checks; players reach games through the dispatch Worker
  // (dispatcher/wrangler.jsonc). Uncomment when the namespace exists.
  // "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "gcp-games" }],
  "vars": {
    // "cloudflare" deploys each game as its own standard Worker (today). "dispatch" deploys each game as a user Worker in
    // the DISPATCH_NAMESPACE dispatch namespace (Workers for Platforms). "local" serves games from this Worker (wrangler dev).
    // Switching from "cloudflare" to "dispatch" moves every game over a few at a time (the scheduled rollout).
    // "shared" serves every game from this Worker on *.<GAME_HOST> (src/game-host.ts); only games with server-run matches
    // keep a standard Worker of their own. Switching moves the games over a few at a time (the scheduled rollout).
    "DEPLOY_DRIVER": "shared",
    "PUBLIC_ORIGIN": "https://hearthcade.com",
    // "DISPATCH_NAMESPACE": "gcp-games",
    // Games are served at <script>.<GAME_HOST>. Needed for "dispatch". With "cloudflare" plus GAME_ZONE_ID, standard
    // game Workers get per-script routes on that host instead of workers.dev, so addresses do not change at the move.
    "GAME_HOST": "hearthcade.app",
    "GAME_ZONE_ID": "696f63e1c098bfd778b39bf941ae69c4",
    "GAMES_BUCKET": "gcp-games",
    "STRIPE_API_BASE": "https://api.stripe.com"
  }
  // Secrets (wrangler secret put …):
  //   SESSION_SECRET          signs play tokens and consent cookies (required)
  //   CF_API_TOKEN            Cloudflare token with Workers Scripts:Edit, used to deploy game Workers (required);
  //                           plus Workers Routes:Edit on GAME_ZONE_ID when that is set
  //   CF_ACCOUNT_ID           the account games are deployed into (required)
  //   ADMIN_CLAIM_TOKEN       one-time token for claiming the first admin account
  //   STRIPE_SECRET_KEY       Stripe restricted key (rk_…; docs/stripe.md lists its permissions): payments + Connect payouts
  //   STRIPE_WEBHOOK_SECRET   signing secret of the payments webhook endpoint (snapshot events)
  //   STRIPE_ACCOUNTS_WEBHOOK_SECRET  signing secret of the creator-accounts event destination (Accounts v2 thin events)
}
