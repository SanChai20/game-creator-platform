{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler", "allowImportingTsExtensions": true, "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowJs": true, "checkJs": false,
    "resolveJsonModule": true, "isolatedModules": true, "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*"]
}
