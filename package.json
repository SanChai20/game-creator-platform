{
  "name": "game-creator-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prepare.mjs",
    "build": "vite build",
    "dev": "npm run build && wrangler dev --port 8787",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "node --test tests/i18n.mjs tests/web-only.mjs tests/procgen.mjs tests/implementation.mjs tests/originality.mjs tests/player-data.mjs tests/compat.mjs tests/gamemeta.mjs tests/tags.mjs tests/smooth.mjs tests/display.mjs tests/moderation.mjs tests/services.mjs tests/server-code.mjs tests/storage.mjs tests/hosting.mjs tests/session-binding.mjs tests/room-wire.mjs tests/payments.mjs tests/match-core.mjs tests/match-making.mjs tests/match-sdk.mjs",
    "test:rooms": "node --test tests/room-live.mjs",
    "test:matches": "node --test --test-concurrency=1 tests/match-live.mjs tests/matchmaker-live.mjs",
    "test:live": "node tests/mcp-live.mjs",
    "db:local": "wrangler d1 migrations apply gcp-db --local",
    "db:remote": "wrangler d1 migrations apply gcp-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^2.0.0",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "acorn": "^8.19.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.161.0"
  }
}
