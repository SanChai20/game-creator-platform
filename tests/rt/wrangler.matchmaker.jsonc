{
  "name": "gcp-matchmaker-test",
  "main": "matchmaker-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "MATCHMAKER", "class_name": "Matchmaker" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Matchmaker"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "gcp-test", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../migrations" }],
  "vars": { "SESSION_SECRET": "test-session-secret" }
}
