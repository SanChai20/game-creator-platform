{
  "name": "gcp-bots-test",
  "main": "bots-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "MATCHMAKER", "class_name": "Matchmaker" }, { "name": "BOTS", "class_name": "BotFleet" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Matchmaker", "BotFleet"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "gcp-test", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "gcp-test-files" }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "vars": { "SESSION_SECRET": "test-session-secret", "DEPLOY_DRIVER": "local" }
}
